{
  "name": "@eriksremess/express-hbs",
  "version": "2.5.1",
  "description": "Fork of express-hbs updated for Node.js 26+ and Express 5.",
  "keywords": [
    "express5",
    "express",
    "handlebars",
    "layout",
    "partials"
  ],
  "main": "lib/hbs.js",
  "types": "types/lib/hbs.d.ts",
  "type": "module",
  "imports": {
    "#hbs": "./lib/hbs.js",
    "#handlebars": "./lib/handlebars/handlebars.js",
    "#handlebars/*": "./lib/handlebars/*.js",
    "#lib/*": "./lib/*.js",
    "#example/*": "./example/*.js",
    "#test/*": "./test/*.js"
  },
  "files": [
    "lib/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "directories": {
    "example": "example"
  },
  "scripts": {
    "lint": "eslint --ext .js --cache lib test example scripts",
    "test": "node --test test/*.js",
    "test:random": "node --test --test-randomize test/*.js",
    "posttest": "npm run lint",
    "ci": "npm test && npm run lint && npm run test:random && npm run types:verify && npm run types:test && npm run coverage",
    "types:clean": "rm -rf types",
    "types:build": "tsc -p tsconfig.types.json && mkdir -p types/lib && cp lib/handlebars.d.ts types/lib/handlebars.d.ts",
    "types:rebuild": "npm run types:clean && npm run types:build",
    "types:verify": "node scripts/verify-types.js",
    "types:test": "tsc -p tsconfig.test-types.json",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='lib/**/*.js' test/*.js",
    "bench": "npm --prefix benchmark run baseline",
    "bench:async": "npm --prefix benchmark run async",
    "bench:large": "npm --prefix benchmark run large",
    "bench:compiler": "npm --prefix benchmark run compiler",
    "bench:parser": "npm --prefix benchmark run parser"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EriksRemess/express-hbs.git"
  },
  "bugs": "https://github.com/EriksRemess/express-hbs/issues",
  "author": "Ēriks Remess <eriks@remess.lv>",
  "contributors": [
    "Mario Gutierrez <mario@barc.com>",
    "TryGhost express-hbs contributors"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "cookie-parser": "1.4.7",
    "eslint": "^10.8.0",
    "express": "git+https://github.com/EriksRemess/express.git#eriks-esm",
    "globals": "^17.7.0",
    "handlebars": "^4.7.9",
    "i18n": "0.15.3",
    "typescript": "^6.0.3"
  }
}
