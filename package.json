{
  "name": "@eriks/express-hbs",
  "version": "2.5.0",
  "description": "Fork of express-hbs updated for modern Node.js and Express 5.",
  "keywords": [
    "express5",
    "express",
    "handlebars",
    "layout",
    "partials"
  ],
  "main": "index.js",
  "types": "types/index.d.ts",
  "type": "module",
  "files": [
    "index.js",
    "lib/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "example": "example"
  },
  "scripts": {
    "lint": "eslint --ext .js --cache lib/**/*.js test/**/*.js example/**/*.js",
    "test": "node --test test/*.js",
    "posttest": "npm run lint",
    "types:clean": "rm -rf types",
    "types:build": "tsc -p tsconfig.types.json",
    "types:rebuild": "npm run types:clean && npm run types:build",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='lib/**/*.js' --test-coverage-include='example/**/*.js' test/*.js",
    "bench": "npm --prefix benchmark run compare",
    "bench:compare-original": "npm --prefix benchmark run compare",
    "bench:compare-original:async": "npm --prefix benchmark run compare:async"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:EriksRemess/express-hbs.git"
  },
  "bugs": "https://github.com/EriksRemess/express-hbs/issues",
  "author": "Ēriks Remess <eriks@remess.lv>",
  "contributors": [
    "Mario Gutierrez <mario@barc.com>",
    "TryGhost express-hbs contributors"
  ],
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "cookie-parser": "1.4.7",
    "eslint": "^10.0.2",
    "express": "^5.2.1",
    "globals": "^17.3.0",
    "i18n": "0.15.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "handlebars": "^4.7.8"
  }
}
